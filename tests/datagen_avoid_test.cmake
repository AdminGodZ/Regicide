# datagen --avoid / --start-parity (lead, 2026-11-11): a second run with --avoid on the first run's file writes no game
# whose start (GAME_START record) is in it; --start-parity writes only starts of that parity. Control: the same run
# without --avoid does repeat the first run's starts (same seed, fresh file, one thread: the same games).
#   cmake -DDATAGEN=<path to datagen> -DWORK=<scratch dir> -P datagen_avoid_test.cmake
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
set(common --games 12 --nodes 300 --threads 1 --seed 5)
function(run out)
  execute_process(COMMAND "${DATAGEN}" ${common} --out "${WORK}/${out}" ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE e)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "datagen ${out}: exit status ${rc}: ${e}")
  endif()
  set(last_out "${o}" PARENT_SCOPE)
endfunction()
function(starts file var)
  execute_process(COMMAND "${DATAGEN}" --list-starts "${WORK}/${file}" RESULT_VARIABLE rc OUTPUT_VARIABLE o)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "datagen --list-starts ${file}: exit status ${rc}")
  endif()
  string(STRIP "${o}" o)
  string(REPLACE "\n" ";" o "${o}")
  set(${var} "${o}" PARENT_SCOPE)
endfunction()
function(overlap a b var)  # number of starts of list b (key only) found in list a
  set(n 0)
  set(keys)
  foreach(l IN LISTS a)
    string(REGEX REPLACE " .*" "" k "${l}")
    list(APPEND keys "${k}")
  endforeach()
  foreach(l IN LISTS b)
    string(REGEX REPLACE " .*" "" k "${l}")
    list(FIND keys "${k}" i)
    if(NOT i EQUAL -1)
      math(EXPR n "${n} + 1")
    endif()
  endforeach()
  set(${var} ${n} PARENT_SCOPE)
endfunction()

run(a.bin)
run(control.bin)
run(b.bin --games 40 --avoid "${WORK}/a.bin" --avoid "${WORK}/b.bin")  # its first 12 draws are a's starts
if(NOT last_out MATCHES "avoid: [1-9][0-9]* game starts preloaded")
  message(FATAL_ERROR "no preload line in the --avoid run: ${last_out}")
endif()
run(p.bin --start-parity 1)
starts(a.bin A)
starts(control.bin C)
starts(b.bin B)
starts(p.bin P)
list(LENGTH A na)
list(LENGTH B nb)
overlap("${A}" "${C}" nc)
overlap("${A}" "${B}" nab)
if(na EQUAL 0 OR nb EQUAL 0)
  message(FATAL_ERROR "no games written (a: ${na}, b: ${nb})")
endif()
if(nc EQUAL 0)
  message(FATAL_ERROR "control: the run without --avoid repeated none of the first run's starts; the test proves nothing")
endif()
if(NOT nab EQUAL 0)
  message(FATAL_ERROR "the --avoid run wrote ${nab} games whose start is in the first run's file")
endif()
foreach(l IN LISTS P)
  if(NOT l MATCHES " 1$")
    message(FATAL_ERROR "--start-parity 1 wrote a start of parity 0: ${l}")
  endif()
endforeach()
message(STATUS "datagen --avoid: ${nb} new games, none with one of the ${na} avoided starts (control repeated ${nc}); --start-parity holds")
